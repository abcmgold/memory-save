# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Neon PostgreSQL connection string (use the pooled URL; a separate `dev` branch for local work)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/memorysave?sslmode=require

# Cloudflare R2 (private bucket — never enable public access)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=memorysave-photos

# Time zone used for "now", default event time and the "not in the future" check
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Long random string; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=change-me-to-a-long-random-string

# Optional (002) — Google sign-in. The "Tiếp tục với Google" button is shown only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (005) — e-mail codes (sign-up, add/change e-mail, forgot password) sent through Gmail SMTP.
# SMTP_USER is the Gmail address; SMTP_PASS is a 16-character App Password (needs 2-Step Verification).
# Without them, production shows "tạm thời chưa dùng được" for those flows; sign-in keeps working.
# Local mode (npm run dev:local) prints mails to the terminal unless MAIL_TRANSPORT=smtp.
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=MemorySave
MAIL_TRANSPORT=
